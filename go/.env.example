# Cutre Go版の環境変数のキー一覧 (サンプル)
# このファイルをコピーして .env を作成し、実際の値を設定する。
# cp .env.example .env

DATABASE_URL=
CUTRE_DOMAIN=
CUTRE_PORT=
# 前段のリバースプロキシのネットワーク (カンマ区切りのCIDRまたはアドレス)。未設定なら転送ヘッダーを読まない。
CUTRE_TRUSTED_PROXIES=
# Cloudflare Turnstileのサイトキーとシークレットキー。両方を空にするとBot対策を無効にする。
CUTRE_TURNSTILE_SITE_KEY=
CUTRE_TURNSTILE_SECRET_KEY=
# 登録の途中の状態を運ぶCookieに署名する鍵 (32バイト以上)。例: openssl rand -base64 48
CUTRE_CONTINUATION_TOKEN_KEY=
# TOTPの秘密鍵の暗号化とリカバリーコードのダイジェストに使う鍵 (32バイト以上)。変えると二要素認証が使えなくなる。例: openssl rand -base64 48
CUTRE_TOTP_ENCRYPTION_KEY=
# メールの送信に使うResendのAPIキーと送信元のアドレス。APIキーを空にすると、送らずにログへ出力する (本番では必須)。
CUTRE_RESEND_API_KEY=
CUTRE_EMAIL_FROM=
CUTRE_EXE_DEV_API_KEY=
KORYLUS_BROWSING_BASE_URL=
