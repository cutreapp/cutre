package password_reset

import (
	"strings"

	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/emails/layouts"
)

// Data はパスワードリセットのメールに描画する値。
type Data struct {
	// ResetURL は新しいパスワードを設定する画面の絶対URL。リンクのトークンをクエリに持つ。
	ResetURL string
}

// HTML はパスワードリセットのメールのHTMLの本文を描画する。
templ HTML(data Data) {
	@layouts.Default(templates.Locale(ctx), templates.T(ctx, "password_reset_email_subject")) {
		<p>{ templates.T(ctx, "password_reset_email_intro") }</p>
		<p><a href={ templ.SafeURL(data.ResetURL) }>{ data.ResetURL }</a></p>
		<p>{ templates.T(ctx, "password_reset_email_expiry") }</p>
		<p>{ templates.T(ctx, "password_reset_email_ignore_if_unexpected") }</p>
	}
}

// Text はパスワードリセットのメールのテキストの本文を描画する。
// 改行を保つため templ.Raw で書き出す理由は確認コードのメールと同じ。
templ Text(data Data) {
	@templ.Raw(strings.Join([]string{
		templates.T(ctx, "password_reset_email_intro"),
		data.ResetURL,
		templates.T(ctx, "password_reset_email_expiry"),
		templates.T(ctx, "password_reset_email_ignore_if_unexpected"),
		"Cutre",
	}, "\n\n") + "\n")
}
