package components

import "github.com/cutreapp/cutre/go/internal/templates"

// HelpContact は、認証アプリもリカバリーコードも無くした人を、ヘルプのお問い合わせのページへ案内する。
// ログインで認証アプリのコードを入力する画面と、リカバリーコードを入力する画面で共有する。
//
// ヘルプは別のサイト (Wikino) のため新しいタブで開き、入力途中の画面を残す。
// 新しいタブで開くことは補足の文で見えるように伝え、リンクの説明として読み上げにも結び付ける。
templ HelpContact() {
	<div class="flex flex-col gap-0.5">
		<p class="text-sm">{ templates.T(ctx, "help_contact_lead") }</p>
		<a
			href={ templ.SafeURL(templates.HelpContactURL) }
			target="_blank"
			rel="noopener"
			aria-describedby="help-contact-new-tab"
			class="inline-flex items-center gap-1 self-start text-sm font-medium underline"
		>
			{ templates.T(ctx, "help_contact_link") }
			<svg aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14L21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
		</a>
		<p id="help-contact-new-tab" class="text-xs text-muted-foreground">{ templates.T(ctx, "help_contact_new_tab") }</p>
	</div>
}
