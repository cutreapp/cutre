package components

import (
	"context"
	"strconv"

	"github.com/cutreapp/cutre/go/internal/templates"
)

// MainNavItem はメインメニューの項目。
type MainNavItem string

const (
	// MainNavHome はホームの項目。
	MainNavHome MainNavItem = "home"
	// MainNavList はリストの項目。リストのアイテムの編集など、リストから辿る画面もここに属する。
	MainNavList MainNavItem = "list"
	// MainNavTrade は交換の項目。交換のページ・マッチ候補・相手のプロフィール・申し込みなど、交換から辿る画面もここに属する。
	MainNavTrade MainNavItem = "trade"
	// MainNavMessage はメッセージの項目。交換ごとのメッセージのページもここに属する。
	MainNavMessage MainNavItem = "message"
	// MainNavMyPage はマイページ (自分のプロフィール) の項目。招待・二要素認証・退会など、マイページから辿る画面もここに属する。
	MainNavMyPage MainNavItem = "my_page"
)

// MainNavData はログイン後のページのメインメニューの描画に使うデータ。
type MainNavData struct {
	// Atname はログイン中のユーザーのアットネーム。マイページへのリンクに使う。
	Atname string
	// Current は表示中のページが属する項目。
	Current MainNavItem
	// CurrentPath は表示中のページのパス。項目の行き先そのものを表示しているかを見分けるのに使う。
	CurrentPath string
	// BottomHidden は、md未満で画面の下に固定するメニューを出さないか。
	// 進行中の交換のメッセージのページのように、入力欄を画面の下に置くページで、入力欄とキーボードにメニューを重ねないために使う。
	// md以上の上に横並びにするメニューは出す。
	BottomHidden bool
}

// ariaCurrent は項目のリンクに付ける aria-current の値を返す。
//
// 行き先そのものを表示しているときは "page"、行き先から辿った画面を表示しているときは "true" を返す。
// どちらも見た目は選択中にするが、"page" は今のページを指すリンクにだけ付け、別のページへのリンクを今のページと読み上げさせない。
func (d MainNavData) ariaCurrent(item MainNavItem, path string) string {
	if d.Current != item {
		return ""
	}
	if d.CurrentPath == path {
		return "page"
	}

	return "true"
}

// MainNav はログイン後のページのメインメニューを描画する。
//
// md未満は画面の下に固定し、md以上はページの上に横並びにする。1つの<nav>を画面の幅で置き直し、
// 同じメニューを2つ出力しない (支援技術のランドマークの一覧に同じ名前が並ばないようにするため)。
// 下に固定したメニューの高さとセーフエリアのぶんの余白は、レイアウトが<html>に付ける data-main-nav を目印に style.css が取る。
//
// ログイン後のページでは「Cutre」の文字の見出しを出さない。
// 項目は行き先の画面があるものだけを置き、行き先を作るタスクで足す。
// 交換の項目には返事や確認を待っている交換の数を、メッセージの項目には未読のメッセージの数を、ミドルウェアがcontextに載せた値から出す。
templ MainNav(data MainNavData) {
	<header class="md:mx-auto md:flex md:h-16 md:w-full md:max-w-5xl md:items-center md:justify-end md:px-8">
		<nav
			aria-label={ templates.T(ctx, "main_nav_label") }
			class={ "fixed inset-x-0 bottom-0 z-40 border-t bg-card pb-[env(safe-area-inset-bottom)] md:static md:border-0 md:bg-transparent md:pb-0", templ.KV("max-md:hidden", data.BottomHidden) }
		>
			<ul class="flex h-16 md:h-auto md:gap-1">
				<li class="flex-1 md:flex-none">
					@mainNavLink(templates.HomePath, templates.T(ctx, "main_nav_home"), data.ariaCurrent(MainNavHome, templates.HomePath), homeIcon())
				</li>
				<li class="flex-1 md:flex-none">
					@mainNavLink(templates.ListPath, templates.T(ctx, "main_nav_list"), data.ariaCurrent(MainNavList, templates.ListPath), listIcon())
				</li>
				<li class="flex-1 md:flex-none">
					@mainNavBadgedLink(templates.TradesPath, templates.T(ctx, "main_nav_trade"), tradeLabel(ctx), data.ariaCurrent(MainNavTrade, templates.TradesPath), tradeIcon(templates.MainNavBadgesFromContext(ctx).AwaitingTradeCount))
				</li>
				<li class="flex-1 md:flex-none">
					@mainNavBadgedLink(templates.MessagesPath, templates.T(ctx, "main_nav_message"), messageLabel(ctx), data.ariaCurrent(MainNavMessage, templates.MessagesPath), messageIcon(templates.MainNavBadgesFromContext(ctx).UnreadMessageCount))
				</li>
				<li class="flex-1 md:flex-none">
					@mainNavLink(templates.ProfilePath(data.Atname), templates.T(ctx, "main_nav_my_page"), data.ariaCurrent(MainNavMyPage, templates.ProfilePath(data.Atname)), myPageIcon())
				</li>
			</ul>
		</nav>
	</header>
}

// mainNavLink はメインメニューの項目のリンクを描画する。current は aria-current の値で、空なら付けない。
//
// md未満はアイコンの下に名前を置いて横幅を等分し、md以上はアイコンと名前を横に並べたピルにする。
templ mainNavLink(path string, label string, current string, icon templ.Component) {
	@mainNavBadgedLink(path, label, "", current, icon)
}

// mainNavBadgedLink は、数字のバッジを重ねたアイコンを持つメインメニューの項目のリンクを描画する。
// accessibleLabel は数を含めたリンクの名前で、空ならリンクの文字をそのまま名前にする。
// バッジの数字だけでは何の数か分からないため、数を含めた名前を aria-label で付ける。
templ mainNavBadgedLink(path string, label string, accessibleLabel string, current string, icon templ.Component) {
	<a
		href={ templ.SafeURL(path) }
		class="flex h-full flex-col items-center justify-center gap-1 whitespace-nowrap text-xs text-muted-foreground aria-[current]:font-semibold aria-[current]:text-foreground md:h-9 md:flex-row md:gap-1.5 md:rounded-full md:border md:border-transparent md:px-3.5 md:text-sm md:font-medium md:aria-[current]:border-border md:aria-[current]:bg-card"
		if current != "" {
			aria-current={ current }
		}
		if accessibleLabel != "" {
			aria-label={ accessibleLabel }
		}
	>
		@icon
		{ label }
	</a>
}

// homeIcon はホームの項目のアイコンを描画する。
templ homeIcon() {
	<svg aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1z"></path></svg>
}

// listIcon はリストの項目のアイコンを描画する。
templ listIcon() {
	<svg aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13"></path><path d="M8 12h13"></path><path d="M8 18h13"></path><path d="M3 6h.01"></path><path d="M3 12h.01"></path><path d="M3 18h.01"></path></svg>
}

// tradeLabel は交換の項目のリンクの名前を返す。返事や確認を待っている交換があれば数を含め、無ければ空 (リンクの文字のまま) を返す。
func tradeLabel(ctx context.Context) string {
	count := templates.MainNavBadgesFromContext(ctx).AwaitingTradeCount
	if count == 0 {
		return ""
	}

	return templates.T(ctx, "main_nav_trade_awaiting_label", map[string]any{"Count": count})
}

// tradeIcon は交換の項目のアイコンを描画する。awaitingCount が1以上なら、返事や確認を待っている交換の数を右上に重ねる。
templ tradeIcon(awaitingCount int64) {
	<span class="relative flex">
		<svg aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3l4 4-4 4"></path><path d="M21 7H8"></path><path d="M7 21l-4-4 4-4"></path><path d="M3 17h13"></path></svg>
		@mainNavCount(awaitingCount)
	</span>
}

// messageLabel はメッセージの項目のリンクの名前を返す。未読のメッセージがあれば数を含め、無ければ空 (リンクの文字のまま) を返す。
func messageLabel(ctx context.Context) string {
	count := templates.MainNavBadgesFromContext(ctx).UnreadMessageCount
	if count == 0 {
		return ""
	}

	return templates.T(ctx, "main_nav_message_unread_label", map[string]any{"Count": count})
}

// messageIcon はメッセージの項目のアイコンを描画する。unreadCount が1以上なら、未読のメッセージの数を右上に重ねる。
templ messageIcon(unreadCount int64) {
	<span class="relative flex">
		<svg aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg>
		@mainNavCount(unreadCount)
	</span>
}

// mainNavCount は、項目のアイコンの右上に重ねる数字のバッジを描画する。count が0なら何も出さない。
// 数はリンクの名前 (aria-label) に含めるため、バッジは読み上げない。
templ mainNavCount(count int64) {
	if count > 0 {
		<span aria-hidden="true" class="badge absolute -top-2 -right-3.5" data-variant="count">{ strconv.FormatInt(count, 10) }</span>
	}
}

// myPageIcon はマイページの項目のアイコンを描画する。
templ myPageIcon() {
	<svg aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"></path></svg>
}
