package admin_event

import (
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
	"github.com/cutreapp/cutre/go/internal/viewmodel"
)

// IndexPageData は管理画面のイベントの一覧の描画に使うデータ。
type IndexPageData struct {
	// ProfilePath はパンくずに置くマイページ (自分のプロフィール) のパス。
	ProfilePath string
	// Events は削除していないイベントを、開始日の新しい順に並べたもの。
	Events []viewmodel.AdminEvent
}

// Index は管理画面のイベントの一覧を描画する。各行はイベントの編集の画面へのリンクにする。
templ Index(data IndexPageData) {
	<div class="flex w-full flex-1 flex-col gap-3 py-4 md:mx-auto md:max-w-180">
		@components.PageHeading(components.PageHeadingData{
			Title: templates.T(ctx, "admin_event_index_heading"),
			Breadcrumbs: []components.Breadcrumb{
				{Label: templates.T(ctx, "admin_event_index_breadcrumb_my_page"), Path: data.ProfilePath},
				{Label: templates.T(ctx, "admin_event_index_breadcrumb_admin"), Path: templates.AdminPath},
			},
		})
		<div class="flex justify-end px-4 md:px-0">
			<a href={ templ.SafeURL(templates.NewAdminEventPath) } class="btn">
				{ templates.T(ctx, "admin_event_index_new_link") }
			</a>
		</div>
		if len(data.Events) == 0 {
			<p class="page-card text-sm text-muted-foreground">{ templates.T(ctx, "admin_event_index_empty") }</p>
		} else {
			<ul class="page-card divide-y py-0">
				for _, event := range data.Events {
					<li>
						<a href={ templ.SafeURL(templates.EditAdminEventPath(event.ID)) } class="-mx-4 flex min-h-12 items-center gap-3 px-4 py-2">
							<span class="flex min-w-0 flex-1 flex-col">
								<span class="text-sm font-medium">{ event.Name }</span>
								<span class="text-sm text-muted-foreground">{ event.Period }</span>
							</span>
							if event.Archived {
								<span class="badge" data-variant="warning">{ templates.T(ctx, "admin_event_index_archived_badge") }</span>
							}
							<svg aria-hidden="true" class="shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
						</a>
					</li>
				}
			</ul>
		}
	</div>
}
