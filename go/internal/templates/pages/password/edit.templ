package password

import (
	"github.com/cutreapp/cutre/go/internal/model"
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
)

// EditPageData は新しいパスワードの設定画面の描画に使うデータ。
type EditPageData struct {
	// Unusable はリンクが使えないとき真になり、フォームの代わりに新しいリンクの申請を案内する。
	Unusable bool

	CSRFToken string
	// Email はパスワードを設定するアカウントのメールアドレス。入力は受け付けず、どのアカウントかを示す。
	Email      string
	FormErrors *model.ValidationError
}

// summaryFields はエラーの要約に並べるフィールドを、フォームに現れる順で持つ。
var summaryFields = []components.FormErrorSummaryField{
	{Name: "password", LabelKey: "password_edit_password_label"},
}

// Edit は新しいパスワードの設定画面を描画する。
//
// アカウントのメールアドレスを、読み取り専用の autocomplete="username" の欄としてパスワードの前に置く。
// パスワードマネージャーが、ログインで入力するメールアドレスの項目のパスワードとして新しい値を保存できるようにするため。
// フォームはPATCHで送る。HTMLのフォームはPATCHを送れないため、POSTに _method を載せて上書きする。
templ Edit(data EditPageData) {
	<div class="flex w-full flex-1 flex-col justify-center gap-6 py-10 md:mx-auto md:max-w-md">
		if data.Unusable {
			@components.AuthHeading(templates.T(ctx, "password_edit_unusable_heading"))
			<div class="page-card flex flex-col gap-4">
				<p>{ templates.T(ctx, "password_edit_unusable_message") }</p>
				<a href={ templ.SafeURL(templates.LocalePath(ctx, templates.PasswordResetPath)) } class="underline">
					{ templates.T(ctx, "password_edit_request_new_link") }
				</a>
			</div>
		} else {
			@components.AuthHeading(templates.T(ctx, "password_edit_heading"))
			<form
				action={ templ.SafeURL(templates.LocalePath(ctx, templates.PasswordPath)) }
				method="post"
				class="page-card flex flex-col gap-4"
				data-disable-on-submit
				data-clear-on-history-restore
			>
				@components.FormErrors(data.FormErrors)
				@components.FormErrorSummary(components.FormErrorSummaryData{Fields: summaryFields, Errors: data.FormErrors})
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<input type="hidden" name="_method" value="PATCH"/>
				<p>{ templates.T(ctx, "password_edit_message") }</p>
				<div role="group" class="field">
					<label for="email">{ templates.T(ctx, "password_edit_email_label") }</label>
					<input id="email" type="email" value={ data.Email } autocomplete="username" readonly/>
				</div>
				<div
					role="group"
					class="field"
					if data.FormErrors.HasFieldError("password") {
						data-invalid
					}
				>
					@components.RequiredFieldLabel("password", templates.T(ctx, "password_edit_password_label"))
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="new-password"
						minlength="8"
						enterkeyhint="done"
						required
						aria-describedby={ passwordDescribedBy(data.FormErrors) }
						if data.FormErrors.HasFieldError("password") {
							aria-invalid="true"
						}
					/>
					<p id="password-hint" class="text-sm">{ templates.T(ctx, "password_edit_password_hint") }</p>
					@components.FieldErrors("password", data.FormErrors)
				</div>
				<button type="submit" class="btn w-full" data-size="lg">
					{ templates.T(ctx, "password_edit_submit") }
				</button>
			</form>
		}
	</div>
}

// passwordDescribedBy はパスワードの欄を説明する要素のidを返す。
// 補足の文は常に結び付け、エラーがあるときはそのメッセージも続けて読ませる。
func passwordDescribedBy(formErrors *model.ValidationError) string {
	if !formErrors.HasFieldError("password") {
		return "password-hint"
	}

	return "password-hint " + components.FieldErrorsDescribedBy("password", formErrors)
}
