package trade

import (
	"github.com/cutreapp/cutre/go/internal/model"
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
	"github.com/cutreapp/cutre/go/internal/viewmodel"
)

// failureSummaryFields はエラーの要約に並べるフィールドを、フォームに現れる順で持つ。
var failureSummaryFields = []components.FormErrorSummaryField{
	{Name: "reason", LabelKey: "trade_failure_reason_label"},
	{Name: "note", LabelKey: "trade_failure_note_label"},
}

// FailurePageData は「交換できなかった」の画面の描画に使うデータ。
type FailurePageData struct {
	// CSRFToken は「交換できなかった」のフォームに載せるトークン。
	CSRFToken string
	// Trade は開いたユーザーから見た、「交換できなかった」を記録する交換。
	Trade viewmodel.TradeDetail
	// Reason・Note は理由とひとことの欄に入れる値。入力の誤りで描き直すときは送られた値を戻す。
	Reason string
	Note   string
	// FormErrors は記録を受け付けなかったときのエラー。
	FormErrors *model.ValidationError
}

// failureReasonChoices は「交換できなかった」の理由の選択肢を、画面に並べる順で返す。
func failureReasonChoices() []reasonChoice {
	reasons := model.TradeFailureReasons()
	choices := make([]reasonChoice, len(reasons))
	for i, reason := range reasons {
		choices[i] = reasonChoice{Value: string(reason), LabelKey: viewmodel.TradeFailureReasonLabelKey(reason)}
	}

	return choices
}

// Failure は、マッチ成立の交換で、理由とひとことを入れて「交換できなかった」を記録する画面を描画する。
//
// 記録すると交換が終わることを伝える文の下に、理由 (必須) とひとこと (任意) のフォームを置く。
// 理由とひとことはメッセージの流れで相手に届く。メッセージの取り扱いへの有効な同意が無ければ、ひとことの欄を出さない。
templ Failure(data FailurePageData) {
	<div class="flex w-full flex-1 flex-col gap-3 py-4 md:mx-auto md:max-w-180">
		@components.PageHeading(components.PageHeadingData{
			Title: templates.T(ctx, "trade_failure_heading"),
			Breadcrumbs: []components.Breadcrumb{
				{Label: templates.T(ctx, "trade_show_breadcrumb_trades"), Path: templates.TradesPath},
				{Label: templates.T(ctx, "trade_show_heading", map[string]any{"Name": data.Trade.PartnerName}), Path: templates.TradePath(data.Trade.ID)},
			},
		})
		<p class="px-4 text-sm md:px-0">{ templates.T(ctx, "trade_failure_lead", map[string]any{"Name": data.Trade.PartnerName}) }</p>
		<form
			action={ templ.SafeURL(templates.TradeFailurePath(data.Trade.ID)) }
			method="post"
			class="page-card flex flex-col gap-4"
			data-disable-on-submit
		>
			@components.FormErrors(data.FormErrors)
			@components.FormErrorSummary(components.FormErrorSummaryData{Fields: failureSummaryFields, Errors: data.FormErrors})
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			@reasonField(templates.T(ctx, "trade_failure_reason_label"), failureReasonChoices(), data.Reason, data.FormErrors)
			if data.Trade.MessageConsentValid {
				@failureNoteField(data)
			}
			<div class="flex flex-col gap-2">
				<button type="submit" class="btn w-full" aria-describedby="trade-failure-submit-hint">{ templates.T(ctx, "trade_failure_submit") }</button>
				<p id="trade-failure-submit-hint" class="text-center text-sm">
					if data.Trade.MessageConsentValid {
						{ templates.T(ctx, "trade_failure_submit_hint", map[string]any{"Name": data.Trade.PartnerName}) }
					} else {
						{ templates.T(ctx, "trade_failure_submit_hint_without_note", map[string]any{"Name": data.Trade.PartnerName}) }
					}
				</p>
			</div>
		</form>
	</div>
}

// failureNoteField は、メッセージで相手に届くひとことの入力欄を描画する。
templ failureNoteField(data FailurePageData) {
	<div
		role="group"
		class="field"
		if data.FormErrors.HasFieldError("note") {
			data-invalid
		}
	>
		@components.OptionalFieldLabel("note", templates.T(ctx, "trade_failure_note_label"))
		<textarea
			id="note"
			name="note"
			rows="3"
			maxlength="1000"
			if data.FormErrors.HasFieldError("note") {
				aria-describedby={ components.FieldErrorsDescribedBy("note", data.FormErrors) }
				aria-invalid="true"
			}
		>{ data.Note }</textarea>
		@components.FieldErrors("note", data.FormErrors)
	</div>
}
