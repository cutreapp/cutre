package trade

import (
	"github.com/cutreapp/cutre/go/internal/model"
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
	"github.com/cutreapp/cutre/go/internal/viewmodel"
)

// completionSummaryFields はエラーの要約に並べるフィールドを、フォームに現れる順で持つ。
var completionSummaryFields = []components.FormErrorSummaryField{
	{Name: "note", LabelKey: "trade_completion_note_label"},
}

// CompletionPageData は「交換できた」の画面の描画に使うデータ。
type CompletionPageData struct {
	// CSRFToken は「交換できた」のフォームに載せるトークン。
	CSRFToken string
	// Trade は開いたユーザーから見た、「交換できた」を押す交換。
	Trade viewmodel.TradeDetail
	// Note はひとことの欄に入れる値。入力の誤りで描き直すときは送られた値を戻す。
	Note string
	// FormErrors は記録を受け付けなかったときのエラー。
	FormErrors *model.ValidationError
}

// Completion は、マッチ成立の交換で、ひとことを入れて「交換できた」を記録する画面を描画する。
//
// 上のカードに交換の品 (受け取った・渡した) を置き、下のカードにひとこと (任意) と、記録したあとに起きることの案内を置く。
// 案内は、相手がまだ押していなければ相手を待つこと、押していれば交換が終わることを伝える。2人とも押して交換が終わったときに、リストの数量が減ることを伝える。
// メッセージの取り扱いへの有効な同意が無ければ、ひとことの欄を出さない。
templ Completion(data CompletionPageData) {
	<div class="flex w-full flex-1 flex-col gap-3 py-4 md:mx-auto md:max-w-180">
		@components.PageHeading(components.PageHeadingData{
			Title: templates.T(ctx, "trade_completion_heading"),
			Breadcrumbs: []components.Breadcrumb{
				{Label: templates.T(ctx, "trade_show_breadcrumb_trades"), Path: templates.TradesPath},
				{Label: templates.T(ctx, "trade_show_heading", map[string]any{"Name": data.Trade.PartnerName}), Path: templates.TradePath(data.Trade.ID)},
			},
		})
		<section class="page-card flex flex-col gap-4" aria-labelledby="trade-completion-trade-heading">
			<h2 id="trade-completion-trade-heading" class="text-sm text-muted-foreground">
				{ templates.T(ctx, "trade_completion_trade_heading", map[string]any{"Name": data.Trade.PartnerName}) }
			</h2>
			@tradeItems("trade-completion-receive-heading", templates.T(ctx, "trade_completion_receive_heading", map[string]any{"Name": data.Trade.PartnerName}), data.Trade.Receive)
			@tradeItems("trade-completion-give-heading", templates.T(ctx, "trade_completion_give_heading"), data.Trade.Give)
		</section>
		<form
			action={ templ.SafeURL(templates.TradeCompletionPath(data.Trade.ID)) }
			method="post"
			class="page-card flex flex-col gap-4"
			data-disable-on-submit
		>
			@components.FormErrors(data.FormErrors)
			@components.FormErrorSummary(components.FormErrorSummaryData{Fields: completionSummaryFields, Errors: data.FormErrors})
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			if data.Trade.MessageConsentValid {
				@completionNoteField(data)
			}
			<p id="trade-completion-notice" class="flex items-start gap-2 rounded-lg bg-muted p-3 text-sm">
				<svg aria-hidden="true" class="mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5"></path><path d="M12 16h.01"></path></svg>
				if data.Trade.PartnerCompleted {
					{ templates.T(ctx, "trade_completion_notice_final", map[string]any{"Name": data.Trade.PartnerName}) }
				} else {
					{ templates.T(ctx, "trade_completion_notice_awaiting_partner", map[string]any{"Name": data.Trade.PartnerName}) }
				}
			</p>
			<button type="submit" class="btn w-full" aria-describedby="trade-completion-notice">
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
				{ templates.T(ctx, "trade_completion_submit") }
			</button>
		</form>
	</div>
}

// completionNoteField は、メッセージで相手に届くひとことの入力欄を描画する。
templ completionNoteField(data CompletionPageData) {
	<div
		role="group"
		class="field"
		if data.FormErrors.HasFieldError("note") {
			data-invalid
		}
	>
		@components.OptionalFieldLabel("note", templates.T(ctx, "trade_completion_note_label"))
		<textarea
			id="note"
			name="note"
			rows="3"
			maxlength="1000"
			aria-describedby={ completionNoteDescribedBy(data.FormErrors) }
			if data.FormErrors.HasFieldError("note") {
				aria-invalid="true"
			}
		>{ data.Note }</textarea>
		<p id="note-hint" class="text-sm">{ templates.T(ctx, "trade_completion_note_hint", map[string]any{"Name": data.Trade.PartnerName}) }</p>
		@components.FieldErrors("note", data.FormErrors)
	</div>
}

// completionNoteDescribedBy はひとことの欄の aria-describedby を、補足とエラーメッセージのidから組み立てる。
func completionNoteDescribedBy(formErrors *model.ValidationError) string {
	if !formErrors.HasFieldError("note") {
		return "note-hint"
	}

	return "note-hint " + components.FieldErrorsDescribedBy("note", formErrors)
}
