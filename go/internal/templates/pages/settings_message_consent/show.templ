package settings_message_consent

import (
	"github.com/cutreapp/cutre/go/internal/model"
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
)

// ShowPageData はメッセージの利用の画面の描画に使うデータ。
type ShowPageData struct {
	// ProfilePath はパンくずに置くマイページ (自分のプロフィール) のパス。
	ProfilePath string
	// Agreed は有効な同意 (今の版の文面への、やめていない同意) があるか。
	Agreed bool
	// AgreedOn は同意した日。Agreed がfalseのときは空。
	AgreedOn string
	// CSRFToken は同意する・同意をやめるフォームに載せるトークン。
	CSRFToken string
	// FormErrors は同意をやめられなかったとき (進行中の交換がある) のエラー。
	FormErrors *model.ValidationError
}

// Show はメッセージの利用の画面を描画する。
// 有効な同意があれば同意した日と内容と、同意をやめるフォームを出す。
// 無ければ (やめた・古い版の文面に同意した・記録が無い) 今の文面と、同意するフォームを出す。
templ Show(data ShowPageData) {
	<div class="flex w-full flex-1 flex-col gap-3 py-4 md:mx-auto md:max-w-180">
		@components.PageHeading(components.PageHeadingData{
			Title:       templates.T(ctx, "settings_message_consent_show_heading"),
			Breadcrumbs: []components.Breadcrumb{{Label: templates.T(ctx, "settings_message_consent_show_breadcrumb_my_page"), Path: data.ProfilePath}},
		})
		if data.Agreed {
			@agreedCard(data)
			@withdrawSection(data)
		} else {
			<p class="px-4 text-sm md:px-0">{ templates.T(ctx, "settings_message_consent_show_lead") }</p>
			@notAgreedCard(data)
		}
	</div>
}

// agreedCard は有効な同意があるときに、同意した日と、同意した内容を描画する。
templ agreedCard(data ShowPageData) {
	<section class="page-card flex flex-col gap-3.5" aria-labelledby="message-consent-terms-heading">
		<div class="flex flex-wrap items-center gap-2">
			<span class="badge" data-variant="brand">{ templates.T(ctx, "settings_message_consent_show_agreed_badge") }</span>
			<span class="text-sm">
				{ templates.T(ctx, "settings_message_consent_show_agreed_on", map[string]any{"Date": data.AgreedOn}) }
			</span>
		</div>
		<h2 id="message-consent-terms-heading" class="text-sm font-semibold">{ templates.T(ctx, "settings_message_consent_show_agreed_terms_heading") }</h2>
		@components.MessageConsentTerms("message-consent-terms")
	</section>
}

// withdrawSection は同意をやめるフォームを描画する。
// フォームはDELETEで送る。HTMLのフォームはDELETEを送れないため、POSTに _method を載せて上書きする。
// 進行中の交換があってやめられなかったときは、そのことをフォームの冒頭に出す。
templ withdrawSection(data ShowPageData) {
	<section class="flex flex-col gap-2" aria-labelledby="message-consent-withdraw-heading">
		<h2 id="message-consent-withdraw-heading" class="px-4 font-semibold md:px-0">{ templates.T(ctx, "settings_message_consent_show_withdraw_heading") }</h2>
		<form
			action={ templ.SafeURL(templates.SettingsMessageConsentPath) }
			method="post"
			class="page-card flex flex-col gap-3"
			data-disable-on-submit
		>
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			@components.FormErrors(data.FormErrors)
			<input type="hidden" name="_method" value="DELETE"/>
			<p class="text-sm">{ templates.T(ctx, "settings_message_consent_show_withdraw_message") }</p>
			<button type="submit" class="btn w-full" data-variant="outline">
				{ templates.T(ctx, "settings_message_consent_show_withdraw_submit") }
			</button>
		</form>
	</section>
}

// notAgreedCard は有効な同意が無いときに、今の文面と、同意するフォームを描画する。
templ notAgreedCard(data ShowPageData) {
	<section class="page-card flex flex-col gap-3.5" aria-labelledby="message-consent-terms-heading">
		<div class="flex flex-wrap items-center gap-2">
			<span class="badge" data-variant="outline">{ templates.T(ctx, "settings_message_consent_show_not_agreed_badge") }</span>
		</div>
		<h2 id="message-consent-terms-heading" class="text-sm font-semibold">{ templates.T(ctx, "settings_message_consent_show_not_agreed_terms_heading") }</h2>
		@components.MessageConsentTerms("message-consent-terms")
		<form
			action={ templ.SafeURL(templates.SettingsMessageConsentPath) }
			method="post"
			class="flex flex-col"
			data-disable-on-submit
		>
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<button type="submit" class="btn w-full">
				{ templates.T(ctx, "settings_message_consent_show_agree_submit") }
			</button>
		</form>
	</section>
}
