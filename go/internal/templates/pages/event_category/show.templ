package event_category

import (
	"github.com/cutreapp/cutre/go/internal/model"
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
	"github.com/cutreapp/cutre/go/internal/viewmodel"
)

// ShowPageData はユーザー向けのカテゴリーのグッズの一覧の描画に使うデータ。
type ShowPageData struct {
	// EventID と EventName は、パンくずに置くカテゴリーのイベントのIDと名前。
	EventID   string
	EventName string
	// EventCategoryName は表示中のカテゴリーの名前。
	EventCategoryName string
	// Goods はカテゴリーの公開中のグッズを並び順に並べ、自分のリストにあるアイテムと組み合わせたもの。
	Goods []viewmodel.GoodsRow
}

// Show はユーザー向けのカテゴリーのグッズの一覧を描画する。
//
// グッズごとに、自分のリストに何点入れているかと、「譲れる」「ほしい」のボタンを置く。
// まだ入れていないリストのボタンは、そのリストを選んだ状態のリストに追加する画面へのリンクにする。
// 入れているリストのボタンは押した状態 (チェックの印) で示し、アイテムの編集の画面へのリンクにする。
templ Show(data ShowPageData) {
	<div class="flex w-full flex-1 flex-col gap-3 py-4 md:mx-auto md:max-w-180">
		@components.PageHeading(components.PageHeadingData{
			Title: data.EventCategoryName,
			Breadcrumbs: []components.Breadcrumb{
				{Label: templates.T(ctx, "event_category_show_breadcrumb_home"), Path: templates.HomePath},
				{Label: templates.T(ctx, "event_category_show_breadcrumb_events"), Path: templates.EventsPath},
				{Label: data.EventName, Path: templates.EventPath(data.EventID)},
			},
		})
		if len(data.Goods) == 0 {
			<p class="page-card text-sm text-muted-foreground">{ templates.T(ctx, "event_category_show_empty") }</p>
		} else {
			<p class="px-4 text-sm md:px-0">{ templates.T(ctx, "event_category_show_lead", map[string]any{"Count": len(data.Goods)}) }</p>
			<ul class="page-card grid grid-cols-2 gap-x-4 py-0">
				for i, row := range data.Goods {
					<li class={ "flex flex-col gap-2 py-3", templ.KV("border-t", i >= 2) }>
						<span aria-hidden="true" class="flex h-19 items-center justify-center rounded-xl border bg-muted text-muted-foreground">
							<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect height="18" rx="3" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="1.5"></circle><path d="M21 15l-5-4-4.5 4"></path></svg>
						</span>
						<span class="flex flex-col">
							<span class="text-sm font-medium">{ row.Name }</span>
							@goodsListedStatus(row)
						</span>
						<span class="flex gap-1.5">
							@goodsKindButton(row, model.ItemKindGive, row.Give)
							@goodsKindButton(row, model.ItemKindWant, row.Want)
						</span>
					</li>
				}
			</ul>
		}
	</div>
}

// goodsListedStatus は、グッズを自分のどのリストに何点入れているかを描画する。どちらにも無ければそう示す。
templ goodsListedStatus(row viewmodel.GoodsRow) {
	if row.Give == nil && row.Want == nil {
		<span class="text-xs text-muted-foreground">{ templates.T(ctx, "event_category_show_not_listed") }</span>
	}
	if row.Give != nil {
		<span class="text-xs text-brand-strong">{ templates.T(ctx, "event_category_show_give_listed", map[string]any{"Quantity": row.Give.Quantity}) }</span>
	}
	if row.Want != nil {
		<span class="text-xs text-brand-strong">{ templates.T(ctx, "event_category_show_want_listed", map[string]any{"Quantity": row.Want.Quantity}) }</span>
	}
}

// goodsKindButton は、グッズをリスト kind に入れるボタンを描画する。
//
// まだ入れていなければ、リストに追加する画面へのリンクにする。どのグッズのボタンかが読み上げで分かるよう、
// 見える文言 (リストの名前) を含めた名前を aria-label で付ける。
// 入れていれば押した状態で示し、アイテムの編集の画面へのリンクにする。リストに入れた状態は aria-current では示さず、
// 読み上げ用の名前と、隣の「譲れるリストにN点」の文言で伝える。
templ goodsKindButton(row viewmodel.GoodsRow, kind model.ItemKind, item *model.Item) {
	if item != nil {
		<a
			href={ templ.SafeURL(templates.EditItemPath(item.ID.String())) }
			class="btn flex-1 gap-1"
			data-size="sm"
			data-listed
			aria-label={ templates.T(ctx, editLabelKey(kind), map[string]any{"Name": row.Name}) }
		>
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
			{ templates.T(ctx, viewmodel.ItemKindLabelKey(kind)) }
		</a>
	} else {
		<a
			href={ templ.SafeURL(templates.NewItemForGoodsPath(row.ID, string(kind))) }
			class="btn flex-1"
			data-variant="outline"
			data-size="sm"
			aria-label={ templates.T(ctx, addLabelKey(kind), map[string]any{"Name": row.Name}) }
		>
			{ templates.T(ctx, viewmodel.ItemKindLabelKey(kind)) }
		</a>
	}
}

// addLabelKey は、リスト kind に追加するボタンの読み上げ用の名前の翻訳キーを返す。
func addLabelKey(kind model.ItemKind) string {
	if kind == model.ItemKindWant {
		return "event_category_show_add_want_label"
	}

	return "event_category_show_add_give_label"
}

// editLabelKey は、リスト kind に入れたグッズのアイテムを編集するボタンの読み上げ用の名前の翻訳キーを返す。
func editLabelKey(kind model.ItemKind) string {
	if kind == model.ItemKindWant {
		return "event_category_show_edit_want_label"
	}

	return "event_category_show_edit_give_label"
}
