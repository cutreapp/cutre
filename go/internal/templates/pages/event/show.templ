package event

import (
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
	"github.com/cutreapp/cutre/go/internal/viewmodel"
)

// ShowPageData はユーザー向けのイベントのカテゴリーの一覧の描画に使うデータ。
type ShowPageData struct {
	// EventID と EventName は、表示中のイベントのIDと名前。
	EventID   string
	EventName string
	// Period はイベントの開催期間。
	Period string
	// GoodsCount はイベントの公開中のグッズの種類の数。
	GoodsCount int64
	// EventCategories はイベントの公開中のカテゴリーを並び順に並べたもの。
	EventCategories []viewmodel.EventCategoryRow
}

// Show はユーザー向けのイベントのカテゴリーの一覧を描画する。
// 上に開催期間とグッズの種類の数を置き、各行はカテゴリーのグッズの一覧へのリンクにして、自分がリストに入れた数量を添える。
templ Show(data ShowPageData) {
	<div class="flex w-full flex-1 flex-col gap-3 py-4 md:mx-auto md:max-w-180">
		@components.PageHeading(components.PageHeadingData{
			Title: data.EventName,
			Breadcrumbs: []components.Breadcrumb{
				{Label: templates.T(ctx, "event_show_breadcrumb_home"), Path: templates.HomePath},
				{Label: templates.T(ctx, "event_show_breadcrumb_events"), Path: templates.EventsPath},
			},
		})
		<p class="page-card text-sm">
			{ templates.T(ctx, "event_index_summary", map[string]any{"Period": data.Period, "Count": data.GoodsCount}) }
		</p>
		<section class="flex flex-col gap-2" aria-labelledby="event-categories-heading">
			<h2 id="event-categories-heading" class="px-4 font-semibold md:px-0">{ templates.T(ctx, "event_show_categories_heading") }</h2>
			if len(data.EventCategories) == 0 {
				<p class="page-card text-sm text-muted-foreground">{ templates.T(ctx, "event_show_empty") }</p>
			} else {
				<ul class="page-card divide-y py-0">
					for _, row := range data.EventCategories {
						<li>
							<a href={ templ.SafeURL(templates.EventCategoryPath(data.EventID, row.ID)) } class="-mx-4 flex min-h-12 items-center gap-3 px-4 py-3">
								<span class="flex min-w-0 flex-1 flex-col gap-0.5">
									<span class="font-semibold">{ row.Name }</span>
									<span class="text-sm text-muted-foreground">
										{ templates.T(ctx, "event_show_goods_count", map[string]any{"Count": row.GoodsCount}) }
									</span>
								</span>
								@components.ItemQuantities(row.Quantities)
								<svg aria-hidden="true" class="shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
							</a>
						</li>
					}
				</ul>
			}
		</section>
	</div>
}
