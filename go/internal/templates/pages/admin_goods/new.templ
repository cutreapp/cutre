package admin_goods

import (
	"github.com/cutreapp/cutre/go/internal/model"
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
	"github.com/cutreapp/cutre/go/internal/viewmodel"
)

// NewPageData は管理画面のグッズの作成の画面の描画に使うデータ。
type NewPageData struct {
	// ProfilePath はパンくずに置くマイページ (自分のプロフィール) のパス。
	ProfilePath string
	// CSRFToken は作成のフォームに載せるトークン。
	CSRFToken string
	// EventID と EventName は、パンくずに置くカテゴリーのイベントのIDと名前。
	EventID   string
	EventName string
	// EventCategoryID はフォームの送信先とパンくずを組み立てる、グッズを作成するカテゴリーのID。
	EventCategoryID string
	// EventCategoryName はパンくずに出すカテゴリーの名前。
	EventCategoryName string
	// Form はフォームに入れる値。エラーで描き直すときは送られた値を戻す。
	Form viewmodel.MasterForm
	// FormErrors は作成のフォームを受け付けなかったときのエラー。
	FormErrors *model.ValidationError
}

// New は管理画面のグッズの作成の画面を描画する。
templ New(data NewPageData) {
	<div class="flex w-full flex-1 flex-col gap-3 py-4 md:mx-auto md:max-w-180">
		@components.PageHeading(components.PageHeadingData{
			Title: templates.T(ctx, "admin_goods_new_heading"),
			Breadcrumbs: []components.Breadcrumb{
				{Label: templates.T(ctx, "admin_goods_new_breadcrumb_my_page"), Path: data.ProfilePath},
				{Label: templates.T(ctx, "admin_goods_new_breadcrumb_admin"), Path: templates.AdminPath},
				{Label: templates.T(ctx, "admin_goods_new_breadcrumb_events"), Path: templates.AdminEventsPath},
				{Label: data.EventName, Path: templates.EditAdminEventPath(data.EventID)},
				{Label: data.EventCategoryName, Path: templates.EditAdminEventCategoryPath(data.EventCategoryID)},
			},
		})
		<form
			action={ templ.SafeURL(templates.AdminEventCategoryGoodsPath(data.EventCategoryID)) }
			method="post"
			class="page-card flex flex-col gap-4"
			data-disable-on-submit
		>
			@components.FormErrors(data.FormErrors)
			@components.FormErrorSummary(components.FormErrorSummaryData{Fields: summaryFields, Errors: data.FormErrors})
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			@goodsFields(data.Form, data.FormErrors)
			<button type="submit" class="btn w-full">
				{ templates.T(ctx, "admin_goods_new_submit") }
			</button>
		</form>
	</div>
}
