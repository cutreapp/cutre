package sign_up

import (
	"github.com/cutreapp/cutre/go/internal/model"
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
)

// NewPageData は登録の画面 (メールアドレスの入力) の描画に使うデータ。
type NewPageData struct {
	// InvitationRequired は使える招待を持たずに開いたとき真になり、フォームの代わりに招待制の案内を出す。
	InvitationRequired bool

	CSRFToken string
	// Email は再描画のときに入力欄へ戻すメールアドレス。
	Email      string
	FormErrors *model.ValidationError
	// TurnstileSiteKey が空のとき (Turnstileを無効にした環境) はウィジェットを描画しない。
	TurnstileSiteKey string
}

// summaryFields はエラーの要約に並べるフィールドを、フォームに現れる順で持つ。
var summaryFields = []components.FormErrorSummaryField{
	{Name: "email", LabelKey: "sign_up_new_email_label"},
}

// New は登録の画面を描画する。
//
// メールアドレスの欄は autocomplete="email" にする。この画面ではまだパスワードを決めず、
// 連絡先としてのアドレスを入力する欄のため。ログインの識別子 (username) としての紐付けは、
// パスワードを決めるアカウント作成の画面で行う。
// 見出しとカードの組み方はログイン画面に揃える。
templ New(data NewPageData) {
	<div class="flex w-full flex-1 flex-col justify-center gap-6 py-10 md:mx-auto md:max-w-md">
		if data.InvitationRequired {
			@components.AuthHeading(templates.T(ctx, "sign_up_new_invitation_required_heading"))
			<div class="page-card flex flex-col gap-4">
				<p>{ templates.T(ctx, "sign_up_new_invitation_required_message") }</p>
				<a href={ templ.SafeURL(templates.RootPath(ctx)) } class="underline">
					{ templates.T(ctx, "sign_up_new_back") }
				</a>
			</div>
		} else {
			@components.AuthHeading(templates.T(ctx, "sign_up_new_heading"))
			<form
				action={ templ.SafeURL(templates.LocalePath(ctx, templates.SignUpPath)) }
				method="post"
				class="page-card flex flex-col gap-4"
				data-disable-on-submit
			>
				@components.FormErrors(data.FormErrors)
				@components.FormErrorSummary(components.FormErrorSummaryData{Fields: summaryFields, Errors: data.FormErrors})
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<div
					role="group"
					class="field"
					if data.FormErrors.HasFieldError("email") {
						data-invalid
					}
				>
					@components.RequiredFieldLabel("email", templates.T(ctx, "sign_up_new_email_label"))
					<input
						id="email"
						name="email"
						type="email"
						value={ data.Email }
						autocomplete="email"
						enterkeyhint="send"
						required
						aria-describedby={ signUpEmailDescribedBy(data.FormErrors) }
						if data.FormErrors.HasFieldError("email") {
							aria-invalid="true"
						}
					/>
					<p id="email-hint" class="text-sm">{ templates.T(ctx, "sign_up_new_email_hint") }</p>
					@components.FieldErrors("email", data.FormErrors)
				</div>
				@components.Turnstile(data.TurnstileSiteKey)
				<button type="submit" class="btn w-full" data-size="lg">
					{ templates.T(ctx, "sign_up_new_submit") }
				</button>
			</form>
		}
	</div>
}

// signUpEmailDescribedBy はメールアドレスの欄を説明する要素のidを返す。
// 補足の文は常に結び付け、エラーがあるときはそのメッセージも続けて読ませる。
func signUpEmailDescribedBy(formErrors *model.ValidationError) string {
	if !formErrors.HasFieldError("email") {
		return "email-hint"
	}

	return "email-hint " + components.FieldErrorsDescribedBy("email", formErrors)
}
