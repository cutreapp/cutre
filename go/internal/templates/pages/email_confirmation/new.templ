package email_confirmation

import (
	"github.com/cutreapp/cutre/go/internal/model"
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
)

// NewPageData は確認コードの入力画面に渡すデータ。
type NewPageData struct {
	CSRFToken string
	// Code は再描画のときに入力欄へ戻す確認コード。
	Code       string
	FormErrors *model.ValidationError
}

// summaryFields はエラーの要約に並べるフィールドを、フォームに現れる順で持つ。
var summaryFields = []components.FormErrorSummaryField{
	{Name: "code", LabelKey: "email_confirmation_new_code_label"},
}

// New はメールで届いた確認コードの入力画面を描画する。
//
// コードの再送は照合とは別のフォームにし、PATCHで送る。HTMLのフォームはPATCHを送れないため、POSTに _method を載せて上書きする。
templ New(data NewPageData) {
	<div class="flex w-full flex-1 flex-col justify-center gap-6 py-10 md:mx-auto md:max-w-md">
		@components.AuthHeading(templates.T(ctx, "email_confirmation_new_heading"))
		<div class="page-card flex flex-col gap-6">
			<form action={ templ.SafeURL(templates.LocalePath(ctx, templates.EmailConfirmationPath)) } method="post" class="flex flex-col gap-4" data-disable-on-submit>
				@components.FormErrors(data.FormErrors)
				@components.FormErrorSummary(components.FormErrorSummaryData{Fields: summaryFields, Errors: data.FormErrors})
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<p>{ templates.T(ctx, "email_confirmation_new_message") }</p>
				<div
					role="group"
					class="field"
					if data.FormErrors.HasFieldError("code") {
						data-invalid
					}
				>
					@components.RequiredFieldLabel("code", templates.T(ctx, "email_confirmation_new_code_label"))
					<input
						id="code"
						name="code"
						type="text"
						value={ data.Code }
						inputmode="numeric"
						pattern="[0-9]{6}"
						maxlength="6"
						autocomplete="one-time-code"
						required
						if data.FormErrors.HasFieldError("code") {
							aria-invalid="true"
							aria-describedby={ components.FieldErrorsDescribedBy("code", data.FormErrors) }
						}
					/>
					@components.FieldErrors("code", data.FormErrors)
				</div>
				<button type="submit" class="btn w-full" data-size="lg">{ templates.T(ctx, "email_confirmation_new_submit") }</button>
			</form>
			<form action={ templ.SafeURL(templates.LocalePath(ctx, templates.EmailConfirmationPath)) } method="post" class="flex flex-col gap-2" data-disable-on-submit>
				<input type="hidden" name="_method" value="PATCH"/>
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<p class="text-sm">{ templates.T(ctx, "email_confirmation_new_resend_message") }</p>
				<button type="submit" class="btn w-full" data-variant="outline">{ templates.T(ctx, "email_confirmation_new_resend_submit") }</button>
			</form>
		</div>
	</div>
}
