package home

import (
	"github.com/cutreapp/cutre/go/internal/model"
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
)

// ShowPageData はログイン後のホームの描画に使うデータ。
type ShowPageData struct {
	// Atname はログイン中のユーザーのアットネーム。
	Atname string
	// Quantities は、譲れる・ほしいのリストそれぞれのアイテムの数量の合計。
	Quantities model.ItemQuantities
	// HasPlaces は交換場所の駅を1つ以上選んでいるか。falseなら交換をはじめる準備のカードを出す。
	HasPlaces bool
	// MatchCount はマッチ候補の人数。
	MatchCount int
}

// Show はログイン後のホームを描画する。
// 物々交換の機能が入るまでの仮の中身で、ログインできたことを確かめられる内容を置く。
// 譲れる・ほしいのリストの数量を、それぞれのリストへのリンクにして出す。
// 交換場所をまだ選んでいないあいだは、交換場所の画面へ案内する準備のカードを先頭に出す。
// マッチ候補の人数は、1人以上ならマッチ候補の画面へのリンクで出し、候補がいないときは目立たせずにほしいリストへ案内する。
templ Show(data ShowPageData) {
	<div class="flex w-full flex-1 flex-col gap-3 py-4 md:mx-auto md:max-w-180">
		@components.PageHeading(components.PageHeadingData{Title: templates.T(ctx, "home_show_heading")})
		<p class="px-4 md:px-0">
			{ templates.T(ctx, "home_show_welcome", map[string]any{"Atname": data.Atname}) }
		</p>
		if !data.HasPlaces {
			@setupCard()
		}
		<div class="page-card flex flex-col gap-2.5">
			@matchesLink(data.MatchCount)
			<div class="flex gap-2.5">
				@listLink(model.ItemKindGive, "home_show_give_list", data.Quantities.Give)
				@listLink(model.ItemKindWant, "home_show_want_list", data.Quantities.Want)
			</div>
		</div>
	</div>
}

// matchesLink は、マッチ候補の人数 count を出す、マッチ候補の画面へのリンクを描画する。
// 候補がいないときは、目立たせない中立の色のカードにし、マッチ候補の画面へはリンクせずにほしいリストへ案内する。
templ matchesLink(count int) {
	if count > 0 {
		<a href={ templ.SafeURL(templates.MatchesPath) } class="flex items-center gap-3 rounded-lg border border-brand-border bg-brand-subtle p-3">
			<span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-card text-brand-strong">
				@matchesIcon()
			</span>
			<span class="flex flex-1 flex-col">
				<span class="font-semibold text-brand-strong">{ templates.T(ctx, "home_show_matches_link", map[string]any{"Count": count}) }</span>
				<span class="text-sm">{ templates.T(ctx, "home_show_matches_hint") }</span>
			</span>
			<svg aria-hidden="true" class="shrink-0 text-brand-strong" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
		</a>
	} else {
		<div class="flex items-start gap-3 rounded-lg border bg-card p-3">
			<span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground">
				@matchesIcon()
			</span>
			<div class="flex flex-1 flex-col items-start gap-0.5">
				<p class="font-semibold">{ templates.T(ctx, "home_show_matches_none") }</p>
				<p class="text-sm">{ templates.T(ctx, "home_show_matches_none_hint") }</p>
				<a href={ templ.SafeURL(templates.ListKindPath(string(model.ItemKindWant))) } class="py-1 text-sm font-medium text-primary">{ templates.T(ctx, "home_show_matches_none_list") }</a>
			</div>
		</div>
	}
}

// matchesIcon は、マッチ候補のカードに出す交換のアイコンを描画する。
templ matchesIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3l4 4-4 4"></path><path d="M21 7H8"></path><path d="M7 21l-4-4 4-4"></path><path d="M3 17h13"></path></svg>
}

// listLink は、リスト kind の名前と数量を出す、リストへのリンクを描画する。labelKey はリストの名前の翻訳キー。
templ listLink(kind model.ItemKind, labelKey string, quantity int64) {
	<a href={ templ.SafeURL(templates.ListKindPath(string(kind))) } class="flex flex-1 flex-col gap-0.5 rounded-lg border p-2.5">
		<span class="text-sm font-medium">{ templates.T(ctx, labelKey) }</span>
		<span class="text-lg font-semibold">{ templates.T(ctx, "home_show_list_quantity", map[string]any{"Quantity": quantity}) }</span>
	</a>
}

// setupCard は、交換場所をまだ選んでいないユーザーに、交換場所の画面へ案内する準備のカードを描画する。
templ setupCard() {
	<section class="page-card" aria-labelledby="home-setup-heading">
		<div class="flex flex-col gap-3 rounded-lg border border-brand-border bg-brand-subtle p-4">
			<div class="flex flex-col gap-1">
				<h2 id="home-setup-heading" class="font-semibold text-brand-strong">{ templates.T(ctx, "home_show_setup_heading") }</h2>
				<p class="text-sm">{ templates.T(ctx, "home_show_setup_message") }</p>
			</div>
			<a href={ templ.SafeURL(templates.SettingsPlacesPath) } class="flex items-center gap-3 rounded-xl border border-brand-line bg-card px-3 py-2.5">
				<span class="flex flex-1 flex-col">
					<span class="font-semibold">{ templates.T(ctx, "home_show_setup_places_link") }</span>
					<span class="text-sm">{ templates.T(ctx, "home_show_setup_places_not_set") }</span>
				</span>
				<svg aria-hidden="true" class="shrink-0 text-brand-strong" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
			</a>
		</div>
	</section>
}
