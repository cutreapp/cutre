package profile

import (
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
	"github.com/cutreapp/cutre/go/internal/viewmodel"
)

// OtherPageData はほかのユーザーのプロフィールの描画に使うデータ。
type OtherPageData struct {
	// Atname はプロフィールのユーザーのアットネーム。
	Atname string
	// Places はプロフィールのユーザーの交換場所を、都道府県ごとにまとめたもの。
	Places []viewmodel.PlaceGroup
	// PlaceNote はプロフィールのユーザーの「ほかに出られるところ」。入れていなければ空。
	PlaceNote string
	// CompletedTradeCount はプロフィールのユーザーが「交換できた」で終えた交換の数。
	CompletedTradeCount int64
	// Match は見ているユーザーとの間で交換できるアイテム。
	Match viewmodel.MatchRows
	// Tradable は、もらえるものと渡せるものがどちらもあり、交換を申し込めるか。
	Tradable bool
}

// Other はほかのユーザーのプロフィールを描画する。
//
// 交換場所と「ほかに出られるところ」を上のカードに、「交換できた」の件数をその下のカードに、見ているユーザーとの間で交換できるもの (あなたとの交換) を下のカードに置く。
// 交換を申し込めるときは、あなたとの交換のカードの下に、組み合わせを選ぶ画面への入口を置く。
// 「ほかに出られるところ」は自由に書ける文のため、改行だけを保ち、リンクにはしない。
templ Other(data OtherPageData) {
	<div class="flex w-full flex-1 flex-col gap-3 py-4 md:mx-auto md:max-w-180">
		@components.PageHeading(components.PageHeadingData{
			Title: templates.T(ctx, "profile_other_heading", map[string]any{"Atname": data.Atname}),
			Breadcrumbs: []components.Breadcrumb{
				{Label: templates.T(ctx, "profile_other_breadcrumb_trades"), Path: templates.TradesPath},
				{Label: templates.T(ctx, "profile_other_breadcrumb_matches"), Path: templates.MatchesPath},
			},
		})
		<section class="page-card flex flex-col gap-3" aria-labelledby="profile-places-heading">
			<div class="flex flex-col gap-0.5">
				<h2 id="profile-places-heading" class="text-sm font-medium">{ templates.T(ctx, "profile_other_places_heading") }</h2>
				if len(data.Places) == 0 {
					<p class="text-sm text-muted-foreground">{ templates.T(ctx, "profile_other_places_empty") }</p>
				} else {
					<p class="text-sm">
						@components.PlaceGroups(data.Places)
					</p>
				}
			</div>
			if data.PlaceNote != "" {
				<div class="flex flex-col gap-0.5">
					<h3 class="text-sm font-medium">{ templates.T(ctx, "profile_other_place_note_label") }</h3>
					<p class="whitespace-pre-line rounded-lg bg-muted px-3 py-2.5 text-sm">{ data.PlaceNote }</p>
				</div>
			}
		</section>
		@components.CompletedTradeCount(data.CompletedTradeCount)
		<section class="flex flex-col gap-3" aria-labelledby="profile-trade-heading">
			<h2 id="profile-trade-heading" class="px-4 font-semibold md:px-0">{ templates.T(ctx, "profile_other_trade_heading") }</h2>
			<div class="page-card flex flex-col gap-4">
				@components.MatchItems(templates.T(ctx, "profile_other_receivable", map[string]any{"Quantity": data.Match.Receivable.Quantity}), data.Match.Receivable, templates.T(ctx, "profile_other_match_empty"))
				@components.MatchItems(templates.T(ctx, "profile_other_givable", map[string]any{"Quantity": data.Match.Givable.Quantity}), data.Match.Givable, templates.T(ctx, "profile_other_match_empty"))
				if data.Tradable {
					<div class="flex flex-col gap-2 border-t pt-3">
						<a href={ templ.SafeURL(templates.NewTradePath(data.Atname)) } class="btn w-full" aria-describedby="profile-propose-hint">{ templates.T(ctx, "profile_other_propose") }</a>
						<p id="profile-propose-hint" class="text-center text-sm">{ templates.T(ctx, "profile_other_propose_hint", map[string]any{"Atname": data.Atname}) }</p>
					</div>
				}
			</div>
		</section>
	</div>
}
