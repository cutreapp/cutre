package profile

import (
	"github.com/cutreapp/cutre/go/internal/templates"
	"github.com/cutreapp/cutre/go/internal/templates/components"
	"github.com/cutreapp/cutre/go/internal/viewmodel"
)

// ShowPageData は自分のプロフィールの描画に使うデータ。
type ShowPageData struct {
	// CSRFToken はログアウトのフォームに載せるトークン。
	CSRFToken string
	// InvitationRemainingCount はこれから招待できる人数。
	InvitationRemainingCount int
	// InvitationJoinedCount は招待で参加した人数。
	InvitationJoinedCount int
	// PlaceSummary は交換場所に選んだ駅の名前をつないだ要約。まだ選んでいないときは空。
	PlaceSummary string
	// MessageConsentAgreed はメッセージの取り扱いに有効な同意をしているか。
	MessageConsentAgreed bool
	// TwoFactorAuthEnabled は二要素認証を有効にしているか。
	TwoFactorAuthEnabled bool
	// CanUseAdmin は管理画面を使えるか (編集者か管理者か)。falseなら管理画面への行を出さない。
	CanUseAdmin bool
	// CompletedTradeCount は「交換できた」で終えた交換の数。
	CompletedTradeCount int64
	// HistoryCounts は終わった交換の段階ごとの数。これまでの交換の画面への行に添える。
	HistoryCounts []viewmodel.TradeHistoryCount
}

// Show はマイページ (自分のプロフィール) を描画する。
//
// 「交換できた」の件数をメニューの上のカードに置き、メニューの交換場所の下に、これまでの交換の画面への行を置く。
// ログアウトは状態を変える操作のため、リンクではなくDELETEを送るフォームにする。
// 退会はパスワードを求める画面を挟むため、その画面へのリンクにする。
// HTMLのフォームはDELETEを送れないため、POSTに _method を載せて上書きする。
templ Show(data ShowPageData) {
	<div class="flex w-full flex-1 flex-col gap-3 py-4 md:mx-auto md:max-w-180">
		@components.PageHeading(components.PageHeadingData{Title: templates.T(ctx, "profile_show_heading")})
		@components.CompletedTradeCount(data.CompletedTradeCount)
		<ul class="page-card divide-y py-0">
			<li>
				<a href={ templ.SafeURL(templates.SettingsInvitationPath) } class="-mx-4 flex min-h-12 items-center gap-3 px-4 py-2">
					<svg aria-hidden="true" class="shrink-0 text-brand-strong" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16v12H4z"></path><path d="M2 5h20v3H2z"></path><path d="M12 5v15"></path><path d="M12 5c-2-3-6-3-6 0"></path><path d="M12 5c2-3 6-3 6 0"></path></svg>
					<span class="flex flex-1 flex-col">
						<span class="text-sm font-medium">{ templates.T(ctx, "profile_show_invitation_link") }</span>
						<span class="text-sm text-muted-foreground">
							{ templates.T(ctx, "profile_show_invitation_summary", map[string]any{"Remaining": data.InvitationRemainingCount, "Joined": data.InvitationJoinedCount}) }
						</span>
					</span>
					<svg aria-hidden="true" class="shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
				</a>
			</li>
			<li>
				<a href={ templ.SafeURL(templates.SettingsPlacesPath) } class="-mx-4 flex min-h-12 items-center gap-3 px-4 py-2">
					<svg aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
					<span class="flex flex-1 flex-col">
						<span class="text-sm font-medium">{ templates.T(ctx, "profile_show_places_link") }</span>
						<span class="text-sm text-muted-foreground">
							if data.PlaceSummary != "" {
								{ data.PlaceSummary }
							} else {
								{ templates.T(ctx, "profile_show_places_not_set") }
							}
						</span>
					</span>
					<svg aria-hidden="true" class="shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
				</a>
			</li>
			<li>
				<a href={ templ.SafeURL(templates.TradeHistoryPath) } class="-mx-4 flex min-h-12 items-center gap-3 px-4 py-2">
					<svg aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l3 2"></path></svg>
					<span class="flex flex-1 flex-col">
						<span class="text-sm font-medium">{ templates.T(ctx, "profile_show_history_link") }</span>
						@components.TradeHistoryCounts(data.HistoryCounts)
					</span>
					<svg aria-hidden="true" class="shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
				</a>
			</li>
			<li>
				<a href={ templ.SafeURL(templates.SettingsMessageConsentPath) } class="-mx-4 flex min-h-12 items-center gap-3 px-4 py-2">
					<svg aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg>
					<span class="flex flex-1 flex-col">
						<span class="text-sm font-medium">{ templates.T(ctx, "profile_show_message_consent_link") }</span>
						<span class="text-sm text-muted-foreground">
							if data.MessageConsentAgreed {
								{ templates.T(ctx, "profile_show_message_consent_agreed") }
							} else {
								{ templates.T(ctx, "profile_show_message_consent_not_agreed") }
							}
						</span>
					</span>
					<svg aria-hidden="true" class="shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
				</a>
			</li>
			<li>
				<a href={ templ.SafeURL(templates.SettingsTwoFactorAuthPath) } class="-mx-4 flex min-h-12 items-center gap-3 px-4 py-2">
					<svg aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"></path><path d="M9 12l2 2 4-4"></path></svg>
					<span class="flex-1 text-sm font-medium">{ templates.T(ctx, "profile_show_two_factor_auth_link") }</span>
					if data.TwoFactorAuthEnabled {
						<span class="badge" data-variant="success">{ templates.T(ctx, "profile_show_two_factor_auth_enabled") }</span>
					} else {
						<span class="badge" data-variant="outline">{ templates.T(ctx, "profile_show_two_factor_auth_disabled") }</span>
					}
					<svg aria-hidden="true" class="shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
				</a>
			</li>
			if data.CanUseAdmin {
				<li>
					<a href={ templ.SafeURL(templates.AdminPath) } class="-mx-4 flex min-h-12 items-center gap-3 px-4 py-2">
						<svg aria-hidden="true" class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-7"></path><path d="M4 10V3"></path><path d="M12 21v-9"></path><path d="M12 8V3"></path><path d="M20 21v-5"></path><path d="M20 12V3"></path><path d="M2 14h4"></path><path d="M10 8h4"></path><path d="M18 16h4"></path></svg>
						<span class="flex-1 text-sm font-medium">{ templates.T(ctx, "profile_show_admin_link") }</span>
						<svg aria-hidden="true" class="shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
					</a>
				</li>
			}
		</ul>
		<div class="mt-auto flex items-center justify-center gap-1 px-4">
			<form action={ templ.SafeURL(templates.UserSessionPath) } method="post" data-disable-on-submit>
				<input type="hidden" name="_method" value="DELETE"/>
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<button type="submit" class="btn" data-variant="ghost">
					{ templates.T(ctx, "profile_show_sign_out") }
				</button>
			</form>
			<span aria-hidden="true" class="h-4 w-px bg-border"></span>
			<a href={ templ.SafeURL(templates.SettingsWithdrawalPath) } class="btn" data-variant="ghost">
				{ templates.T(ctx, "profile_show_withdrawal_link") }
			</a>
		</div>
	</div>
}
